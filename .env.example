APP_NAME="ÚnicoPag Disparos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Horário da casa: janelas, agenda e carimbos do painel.
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produção: MySQL/MariaDB (Forge), como o KYC e o MED. Local/CI: sqlite funciona.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=unicopag_disparo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fila em banco: precisa do worker (php artisan queue:work) rodando - o disparo:diagnostico confere.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="disparo@unicopag.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Disparo -----------------------------------------------------------------
# Interruptor geral. false = SIMULAÇÃO: nenhuma mensagem sai, a campanha roda inteira como prévia
# executada (destinatários `simulado`, com o motivo real de quem seria pulado). Só ligue depois de
# importar o histórico da Kapso de cada número e de conferir a primeira campanha em simulação.
DISPARO_ENVIO_HABILITADO=false

# Segredo do HMAC dos hashes de telefone e CPF/CNPJ (supressão, dedupe, trilha por contato). Gere com
# `openssl rand -hex 32`. Não é o APP_KEY. NUNCA troque depois do primeiro import: todo hash deixaria
# de casar e os bloqueios deixariam de valer. Produção não sobe sem ele.
DISPARO_HASH_PEPPER=

# Teto que nenhum remetente ultrapassa, mesmo editado no painel (o incidente de 26/10 foi 650 num dia).
DISPARO_TETO_MAXIMO_ABSOLUTO=1000
# Padrões de remetente novo (editáveis por número em Configuração > Remetentes).
DISPARO_TETO_DIARIO=200
DISPARO_MSGS_POR_MINUTO=20
DISPARO_JANELA_INICIO=08:00
DISPARO_JANELA_FIM=20:00
DISPARO_AQUECIMENTO_TETO_INICIAL=50
DISPARO_AQUECIMENTO_FATOR=1.5
# Guardas por contato.
DISPARO_CONVERSA_ABERTA_DIAS=7
DISPARO_FREQUENCIA_MAX_30D=2
DISPARO_MARKETING_MAX_30D=1
DISPARO_MARKETING_MAX_90D=3
DISPARO_SEM_WHATSAPP_DIAS=90
# Primeira leva de campanha MARKETING espera este tempo lendo os webhooks antes de seguir.
DISPARO_TRANCHE_ESPERA_MIN=90
# Operação solo: quem criou aprova a própria campanha só com espera e teto por campanha.
DISPARO_AUTO_APROVACAO_ESPERA_MIN=30
DISPARO_AUTO_APROVACAO_TETO=200
# Custo estimado por conversa (R$), para a prévia e a aprovação.
DISPARO_CUSTO_MARKETING=0.40
DISPARO_CUSTO_UTILITY=0.05
# Retenção (LGPD): texto/payload/variáveis das mensagens, e lead externo sem interação.
DISPARO_RETENCAO_CONTEUDO_DIAS=180
DISPARO_RETENCAO_LEAD_MESES=12
# Ajustes finos (padrões em config/disparo.php): fuso, janela inicial do histórico da Kapso (dias), timeout
# dos provedores (s), intervalo mínimo entre passos de régua (dias).
# DISPARO_FUSO=America/Sao_Paulo
# DISPARO_HISTORICO_JANELA_INICIAL_DIAS=180
# DISPARO_PROVEDOR_TIMEOUT=30
# DISPARO_REGUA_MIN_DIAS=5
# DISPARO_LOTE=20

# --- Kapso (WhatsApp oficial) --------------------------------------------------
# Chave de projeto usada por remetente Kapso sem chave própria (Configuração > Remetentes).
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai
KAPSO_GRAPH_VERSION=v24.0
# O segredo e a chave de URL do webhook são gerados pela plataforma (php artisan disparo:registrar-webhook).

# --- Meta Cloud API direta (remetente provider=meta) ----------------------------
# Token permanente de usuário do sistema (Business Manager > Usuários do sistema), para remetente sem
# token próprio. Webhook do App (Meta for Developers > WhatsApp > Configuration):
META_WHATSAPP_TOKEN=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Integrações ----------------------------------------------------------------
# X-API-Key da API (/api/v1): MCP, KYC (supressões compartilhadas). Vazio = API desligada.
API_KEY=
# unico-api: cadastro do seller (telefone, primeiro nome) para a base de sellers inativos. Chave própria
# do Disparo, não a do MED.
UNICOPAG_API_BASE_URL=https://vps1.unicopag.com.br
UNICOPAG_API_KEY=
UNICOPAG_REGISTER_ENDPOINT=/api/kyc-panel/accounts/{account_id}/register
# Lista de sellers inativos (JSON: account_id, telefone?, nome?, email?, ultima_venda_em?, dias_sem_venda?,
# etapa?, aprovado_em?). Ainda não existe no unico-api: até lá, `disparo:importar-sellers-inativos --arquivo=`.
UNICOPAG_SELLERS_ENDPOINT=

# --- Alertas --------------------------------------------------------------------
# Canal da operação no Discord. Vazio = só log. Nunca leva PII (scrubber).
DISCORD_DISPARO_WEBHOOK_URL=
DISCORD_DISPARO_ROLE_ID=
