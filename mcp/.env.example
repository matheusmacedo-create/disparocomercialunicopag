# === WhatsApp Business Cloud API (Meta) ===
# Meta for Developers > seu App > WhatsApp > Configuração da API
# Use um token PERMANENTE de System User (Business Manager > Usuários do sistema),
# com as permissões whatsapp_business_messaging e whatsapp_business_management.
WHATSAPP_TOKEN=EAAG...

# ID do número +55 21 92367-4860 (Matheus Macedo -ÚnicoPag Checkout|Gateway)
# Já é o padrão no código; só altere para usar outro número.
WHATSAPP_PHONE_NUMBER_ID=1161905150334981

# ID da conta do WhatsApp Business (WABA) da Unicopag — usado para listar templates
WHATSAPP_WABA_ID=1278445183736183

# Versão da Graph API
GRAPH_API_VERSION=v23.0

# === Parâmetros de disparo ===
# Mensagens por segundo (mantenha baixo para proteger a qualidade do número)
DISPARO_MSG_POR_SEGUNDO=5
# Limite máximo de envios por execução (proteção contra disparo acidental)
DISPARO_LIMITE_POR_EXECUCAO=1000
# Código do país aplicado a números sem DDI
DISPARO_DDI_PADRAO=55

# === Plataforma de disparos (raiz do repositório) ===
# As ferramentas disparo_* do MCP falam com a API da plataforma; o envio em massa é lá (painel /admin).
DISPARO_API_URL=https://disparo.unicopag.com.br
DISPARO_API_KEY=
# Envio real direto na Meta por este MCP/CLI fica desligado; só para emergência conhecida:
# MCP_ENVIO_REAL=true
